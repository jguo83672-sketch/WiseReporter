# ==============================================
# WiseReporter 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# cp .env.example .env
# ==============================================

# Flask 运行模式：development / production
FLASK_CONFIG=production

# 密钥（生产环境请务必修改！）
SECRET_KEY=your-strong-secret-key-change-me-please

# 数据库连接（默认 SQLite，生产环境建议用 PostgreSQL）
# SQLite（本地文件，不需要额外服务）
DATABASE_URL=sqlite:///instance/wisereporter.db
# PostgreSQL（需要先启动 PostgreSQL 服务）
# DATABASE_URL=postgresql://wisereporter:changeme@db:5432/wisereporter

# AI 功能配置
# Coze 工作流 Token（微信公众号链接获取）
COZE_API_TOKEN=your-coze-api-token

# OpenRouter API Key（AI 摘要生成）
OPENROUTER_API_KEY=your-openrouter-api-key
